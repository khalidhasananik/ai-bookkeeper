    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.baseUrl }}/v3/company/{{ $('Config').first().json.realmId }}/query",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "quickBooksOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "select * from Account where Active = true MAXRESULTS 1000"
            },
            {
              "name": "minorversion",
              "value": "={{ $('Config').first().json.minorVersion }}"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-0008-4000-8000-000000000008",
      "name": "Load QB Accounts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "// Match each approved row to QuickBooks accounts.\n// Accounts are matched on FullyQualifiedName, because \"Equipment Rental\"\n// exists twice in the sandbox (top level and under Job Expenses).\nconst cfg = $('Config').first().json;\nconst accounts = $input.first().json.QueryResponse?.Account ?? [];\nconst byFqn = new Map(accounts.map(a => [a.FullyQualifiedName, a]));\n\nconst pay = accounts.find(a => a.FullyQualifiedName === cfg.paymentAccount && a.AccountType === 'Credit Card');\nif (!pay) throw new Error(`Credit card account \"${cfg.paymentAccount}\" not found in QuickBooks`);\n\nreturn $('Get Approved Rows').all().map(item => {\n  const j = item.json;\n  const f = j.fields ?? j;\n  const acct = byFqn.get(f.Category);\n  const amount = Math.round(Number(f.Amount) * 100) / 100;\n  const currency = String(f.Currency || 'USD').toUpperCase();\n  const problems = [];\n  if (!acct) problems.push(`no QuickBooks account \"${f.Category}\"`);\n  if (!String(f.Vendor || '').trim()) problems.push('vendor missing');\n  if (!(amount > 0)) problems.push('amount missing or not positive');\n  if (!/^\\d{4}-\\d{2}-\\d{2}/.test(f.Date || '')) problems.push('date missing');\n  if (currency !== 'USD') problems.push(`currency ${currency} (sandbox company is USD only)`);\n  return {\n    json: {\n      recordId: j.id,\n      emailId: f['Email ID'],\n      date: String(f.Date || '').slice(0, 10),\n      vendor: String(f.Vendor || '').trim(),\n      amount,\n      currency,\n      cardLast4: f['Card Last4'] ?? '',\n      category: f.Category,\n      confidence: f.Confidence,\n      expenseAccountId: acct?.Id ?? null,\n      paymentAccountId: pay.Id,\n      ready: problems.length === 0,\n      problem: problems.join('; '),\n    },\n  };\n});"
      },
